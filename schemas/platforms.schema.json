{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "The platforms' registry",
 "type": "object",
 "required": [
  "schema",
  "generated",
  "platforms"
 ],
 "properties": {
  "schema": {
   "const": 1
  },
  "generated": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "source": {
   "type": "string"
  },
  "platform": {
   "type": "string"
  },
  "license": {
   "type": "string"
  },
  "part": {
   "type": "integer"
  },
  "parts": {
   "type": "integer"
  },
  "platforms": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "name",
     "kind"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "qid": {
      "type": "string",
      "pattern": "^Q\\d+$"
     },
     "igdb": {
      "type": "string"
     },
     "aurore": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "store",
       "console",
       "retro"
      ]
     }
    }
   }
  }
 },
 "$id": "https://cdn.jsdelivr.net/gh/JigSawFr/Atlas@data/schemas/platforms.schema.json"
}
