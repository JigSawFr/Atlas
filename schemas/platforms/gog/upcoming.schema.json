{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "The games still to come: [YYYYMMDD, name] (or with IGDB's hypes)",
 "type": "object",
 "required": [
  "schema",
  "generated",
  "games"
 ],
 "properties": {
  "schema": {
   "const": 1
  },
  "generated": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "source": {
   "type": "string"
  },
  "platform": {
   "type": "string"
  },
  "license": {
   "type": "string"
  },
  "part": {
   "type": "integer"
  },
  "parts": {
   "type": "integer"
  },
  "games": {
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "minItems": 2,
    "maxItems": 3,
    "prefixItems": [
     {
      "type": "integer",
      "minimum": 0,
      "maximum": 99991231
     },
     {
      "type": "string"
     },
     {
      "type": "integer"
     }
    ]
   }
  }
 },
 "$id": "https://cdn.jsdelivr.net/gh/JigSawFr/Atlas@data/schemas/platforms/gog/upcoming.schema.json"
}
