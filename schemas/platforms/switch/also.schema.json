{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "A Switch game's other stores: {title id: {platform: [ids]}}",
 "type": "object",
 "required": [
  "schema",
  "generated",
  "games"
 ],
 "properties": {
  "schema": {
   "const": 1
  },
  "generated": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "source": {
   "type": "string"
  },
  "platform": {
   "type": "string"
  },
  "license": {
   "type": "string"
  },
  "part": {
   "type": "integer"
  },
  "parts": {
   "type": "integer"
  },
  "games": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "minProperties": 1,
    "properties": {
     "steam": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[0-9]+$"
      }
     },
     "ps": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[0-9]+$"
      }
     },
     "xbox": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "gog": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "epic": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  }
 },
 "$id": "https://cdn.jsdelivr.net/gh/JigSawFr/Atlas@data/schemas/platforms/switch/also.schema.json"
}
