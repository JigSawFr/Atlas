{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Where a game is read on Wikipedia: its share of views (percent) in each of `languages`, and its rank in each among the file's games",
 "type": "object",
 "required": [
  "schema",
  "generated",
  "games"
 ],
 "properties": {
  "schema": {
   "const": 1
  },
  "generated": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "source": {
   "type": "string"
  },
  "platform": {
   "type": "string"
  },
  "license": {
   "type": "string"
  },
  "part": {
   "type": "integer"
  },
  "parts": {
   "type": "integer"
  },
  "languages": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 1
  },
  "base": {
   "type": "array",
   "items": {
    "type": "number",
    "minimum": 0,
    "maximum": 100
   }
  },
  "counts": {
   "type": "array",
   "items": {
    "type": "integer",
    "minimum": 0
   }
  },
  "ranks": {
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "games": {
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "minItems": 1,
    "items": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    }
   }
  }
 },
 "$id": "https://cdn.jsdelivr.net/gh/JigSawFr/Atlas@data/schemas/platforms/steam/reach.schema.json"
}
