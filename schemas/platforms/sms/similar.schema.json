{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Each game's most alike: [[id, 1..100]]",
 "type": "object",
 "required": [
  "schema",
  "generated",
  "games"
 ],
 "properties": {
  "schema": {
   "const": 1
  },
  "generated": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "source": {
   "type": "string"
  },
  "platform": {
   "type": "string"
  },
  "license": {
   "type": "string"
  },
  "part": {
   "type": "integer"
  },
  "parts": {
   "type": "integer"
  },
  "games": {
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "array",
     "minItems": 2,
     "maxItems": 2,
     "prefixItems": [
      {
       "type": "string"
      },
      {
       "type": "integer",
       "minimum": 1,
       "maximum": 100
      }
     ]
    }
   }
  }
 },
 "$id": "https://cdn.jsdelivr.net/gh/JigSawFr/Atlas@data/schemas/platforms/sms/similar.schema.json"
}
